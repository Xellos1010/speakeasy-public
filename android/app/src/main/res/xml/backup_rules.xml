<?xml version="1.0" encoding="utf-8"?>
<!-- Android <= 11 (and allowBackup=false already disables it): exclude everything. Dictation
     history, queued raw audio and the device token must never leave the phone via backup. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
